# Copy to .env and adjust. Never commit real values.

NODE_ENV=development

# API
API_PORT=3001
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
LOG_LEVEL=info

# Database (docker-compose defaults)
DATABASE_URL=postgresql://lobby:lobby@localhost:5432/lobby
DATABASE_URL_TEST=postgresql://lobby:lobby@localhost:5432/lobby_test

# Redis
REDIS_URL=redis://localhost:6379

# Auth (Phase 2). Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# S3 (Phase 4). SeaweedFS locally; leave S3_ENDPOINT empty on AWS.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=lobby
AWS_SECRET_ACCESS_KEY=lobby-s3-secret
AWS_S3_BUCKET=lobby-documents
S3_ENDPOINT=http://localhost:8333

# Observability (optional)
SENTRY_DSN=

# Web
API_URL=http://localhost:3001
